# Скопировать в .env и заполнить. Файл .env в git не попадает.

# --- Django ---
DJANGO_SECRET_KEY=смените-на-случайную-строку-минимум-50-символов
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=dachpedigrees.com,www.dachpedigrees.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://dachpedigrees.com,https://www.dachpedigrees.com
DJANGO_LOG_LEVEL=INFO
# включить только после того, как заработает HTTPS, иначе получите цикл редиректов
DJANGO_SECURE_SSL_REDIRECT=0

# --- Postgres ---
POSTGRES_DB=dachs
POSTGRES_USER=dachs
POSTGRES_PASSWORD=смените-меня
POSTGRES_HOST=db
POSTGRES_PORT=5432
